# n8n instance
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Singapore

# Persist across restarts — generate once (e.g. openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# Provisioning via @n8n/cli (Settings → n8n API → Create API key)
N8N_URL=http://localhost:5678
N8N_API_KEY=

# Telegram
# BotFather token → create n8n credential "Telegram Bot" (Access Token). Not read via $env.
TELEGRAM_BOT_TOKEN=
# Injected into the n8n container; Test workflow reads $env.TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=
