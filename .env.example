# Docker Compose interpolation (repo root, next to docker-compose.yml).
# Copy to .env and fill. These are injected into containers — not used by `pnpm provision`.

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Singapore

# Persist across restarts — generate once (e.g. openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# Injected into the n8n container; workflows read $env.TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=

# Comma-separated GitHub repos (owner/name) for the Repo Audit workflow
AUDIT_REPOS=Acrylic125/mgt,Acrylic125/fstars

# Injected into n8n-runner-service, then into each audit-runner container
GITHUB_TOKEN=
